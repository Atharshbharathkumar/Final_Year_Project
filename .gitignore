.idea/
*.iml
*.iws
.classpath
.project
.settings/

# --- OS ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Office temp files ---
~$*.pptx
~$*.docx
~$*.xlsx
